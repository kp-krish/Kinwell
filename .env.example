# Copy this file to .env and fill in values. Never commit .env.

AWS_REGION=us-west-2
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=        # E.164, e.g. +16025551234
DEMO_PHONE_NUMBER=          # your phone, E.164

# MongoDB Atlas
MONGODB_URI=

# Gemini
GEMINI_API_KEY=

# Supermemory
SUPERMEMORY_API_KEY=

# TinyFish
TINYFISH_API_KEY=

# Maritime (only if it uses a token instead of CLI login)
MARITIME_TOKEN=
